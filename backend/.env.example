# Copy to backend/.env and fill in from your Supabase dashboard:
#   Settings -> API -> Project URL / Service role key
#
# SERVICE ROLE KEY BYPASSES ROW LEVEL SECURITY. Never commit backend/.env,
# never ship this key to the browser. Server-side only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
PORT=4000

# Dev-only: the shared password seed-dev-passwords.js writes onto the
# @ets-demo.com accounts. Must match VITE_DEV_PASSWORD in frontend/.env.
DEV_PASSWORD=

# Comma-separated list of browser origins allowed to call this API.
# Off-production any http://localhost:<port> is allowed regardless.
FRONTEND_ORIGIN=http://localhost:5173
