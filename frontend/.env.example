# Copy to frontend/.env and fill in from your Supabase dashboard:
#   Settings -> API -> Project URL / Publishable (anon) key
# Vite only exposes vars prefixed with VITE_, and only reads them at startup.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# Dev-only: enables the one-click account picker on the login screen and is
# the password it signs in with. Must match DEV_PASSWORD in backend/.env, and
# only has an effect in `npm run dev` — production builds drop the picker.
VITE_DEV_PASSWORD=

# Where the backend API runs. Only the HR "add employee" form uses it —
# everything else talks to Supabase directly.
VITE_API_URL=http://localhost:4000
