# Copy to frontend/.env and fill in from your Supabase dashboard:
#   Settings -> API -> Project URL / Publishable (anon) key
# Vite only exposes vars prefixed with VITE_, and only reads them at startup.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE
